pp_check(m_perc_fSPL, ndraws = 100) + ggtitle("PPC – perception of fricative SPL")
# Chunk 63: expl-perc-display-fpeak
summary(m_perc_fpeak)
pp_check(m_perc_fpeak, ndraws = 100) + ggtitle("PPC – perception of fricative peak frequency")
# Chunk 64: rq4
m_anim_dur <- fit_perc_bin("animate_judgment", "vowel_dur_ms_mean_z")
m_anim_f0  <- fit_perc_bin("animate_judgment", "f0_mean_z")
# Chunk 65: expl-anim-display-dur
