# Per-item table enriched with size, animacy, AND the 6-way category.
# The category column lives in `alle`, so we join through item_glossary.
item_cute_full <- item_cuteness |>
left_join(
alle |> distinct(item_norm, size, animacy, category) |>
left_join(item_glossary, by = "item_norm") |>
select(item_english, size, animacy, category),
by = "item_english"
) |>
mutate(
cuteness_se = cuteness_sd / sqrt(n_raters),
# Order categories: animals first, objects second; within each block,
# ordered roughly by intuition (mammals > birds > reptiles; appliances,
# instruments, vehicles)
category = factor(category,
levels = c("mammal", "bird", "reptile",
"appliance", "instrument", "vehicle"))
)
ggplot(item_cute_full, aes(x = category, y = cuteness_mean, colour = animacy)) +
geom_jitter(width = 0.18, height = 0, size = 2.6, alpha = 0.85) +
stat_summary(fun = mean, geom = "crossbar",
width = 0.55, linewidth = 0.3, colour = "black",
fatten = 0) +
scale_colour_manual(values = colorBlindBlack8[c(3, 4)]) +
scale_y_continuous(limits = c(1, 7), breaks = 1:7) +
labs(x = NULL, y = "Mean cuteness rating",
colour = "Animacy",
title = "Cuteness by stimulus category",
subtitle = "Animacy explains most but not all of the variance – within-animacy gradients remain")
ggplot(item_cute_full,
aes(x = cuteness_mean, y = fct_reorder(item_english, cuteness_mean),
colour = animacy, shape = size)) +
geom_segment(aes(xend = 1, yend = fct_reorder(item_english, cuteness_mean)),
colour = "grey85", linewidth = 0.3) +
geom_pointrange(aes(xmin = cuteness_mean - cuteness_se,
xmax = cuteness_mean + cuteness_se),
size = 0.4, fatten = 3) +
scale_colour_manual(values = colorBlindBlack8[c(3, 4)]) +
scale_shape_manual(values = c(small = 16, big = 17)) +
scale_x_continuous(limits = c(1, 7), breaks = 1:7) +
labs(x = "Mean cuteness rating (1–7), ± 1 SE across raters",
y = NULL,
colour = "Animacy", shape = "Size",
title = "Per-item cuteness, ranked",
subtitle = "Animals cluster at the cute end; objects at the not-cute end")
# Build the enriched per-item table (item_cuteness + size/animacy/category).
# Created here so this chunk is self-contained; the later viz chunks
# (cuteness-ranked, cuteness-by-category) reuse the object.
item_cute_full <- item_cuteness |>
left_join(
alle |> distinct(item_norm, size, animacy, category) |>
left_join(item_glossary, by = "item_norm") |>
select(item_english, size, animacy, category),
by = "item_english"
) |>
mutate(
cuteness_se = cuteness_sd / sqrt(n_raters),
category    = factor(category,
levels = c("mammal", "bird", "reptile",
"appliance", "instrument", "vehicle"))
)
# Pre-jitter so geom_text_repel and geom_point share the same x positions.
set.seed(2137)
plot_dat <- item_cute_full |>
mutate(
size_num = as.numeric(factor(size, levels = c("big", "small"))),
x        = size_num + runif(n(), -0.09, 0.09)
)
# Cell means as a tiny tibble we draw as crossbars
cell_means <- item_cute_full |>
group_by(animacy, size) |>
summarise(cm = mean(cuteness_mean), .groups = "drop") |>
mutate(size_num = as.numeric(factor(size, levels = c("big", "small"))))
ggplot(plot_dat, aes(x = x, y = cuteness_mean)) +
geom_segment(data = cell_means,
aes(x = size_num - 0.28, xend = size_num + 0.28,
y = cm, yend = cm),
colour = "black", linewidth = 0.7,
inherit.aes = FALSE) +
geom_text(data = cell_means,
aes(x = size_num, y = 7.05, label = sprintf("M = %.2f", cm)),
colour = "grey25", size = 3.1, fontface = "italic",
inherit.aes = FALSE) +
geom_point(aes(colour = animacy), size = 2.6, alpha = 0.9) +
ggrepel::geom_text_repel(
aes(label = item_english, colour = animacy),
size = 3.0, max.overlaps = Inf,
box.padding = 0.32, point.padding = 0.18,
min.segment.length = 0,
segment.alpha = 0.45, segment.size = 0.25,
force = 1.4, force_pull = 0.6,
seed = 2137,
show.legend = FALSE
) +
facet_wrap(~ animacy) +
scale_x_continuous(
breaks = c(1, 2), labels = c("big", "small"),
limits = c(0.4, 2.6)
) +
scale_y_continuous(limits = c(1, 7.25), breaks = 1:7) +
scale_colour_manual(values = colorBlindBlack8[c(3, 4)]) +
labs(
x = NULL, y = "Mean cuteness rating (1–7)",
title    = "Per-item cuteness by size and animacy",
subtitle = "Black bars = cell means · each labelled point is one of the 36 stimulus items"
) +
theme(
legend.position  = "none",
panel.spacing.x  = unit(1.2, "lines"),
strip.text       = element_text(face = "bold", size = 11)
)
