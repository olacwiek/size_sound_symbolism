#################### packages ####################
# Core tidyverse for wrangling + plotting; janitor/skimr for quick structure checks; patchwork for combining plots
library(tidyverse)
library(janitor)
library(skimr)
library(knitr)
library(cowplot)
library(ggdist)
# Bayesian
library(brms);
library(loo);packageVersion("loo")
library(HDInterval);packageVersion("HDInterval")
library(cmdstanr);
library(emmeans);packageVersion("emmeans")
library(posterior);
library(bayesplot);
library(BayesFactor);
library(tidybayes);packageVersion("tidybayes")
library(bayestestR);
library(cmdstanr)
options(brms.backend = "cmdstanr") # Speed gain: ~30-50% faster than rstan
options(brms.file_refit = "on_change")  # only refit if model changes
# use all available cores for parallel computing
options(mc.cores = parallel::detectCores())
theme_set(theme_tidybayes() + panel_border());
# Keep plots/readability consistent
theme_set(theme_minimal(base_size = 14))
colorBlindBlack8  <- c("#000000", "#E69F00", "#56B4E9", "#009E73",
"#F0E442", "#0072B2", "#D55E00", "#CC79A7")
# Figure and Table caption adapted from https://stackoverflow.com/questions/37116632/rmarkdown-html-number-figures:
outputFormat = opts_knit$get("rmarkdown.pandoc.to"); # determine the output format of the document
if( is.null(outputFormat) ) outputFormat = ""; # probably not run within knittr
capTabNo = 1; capFigNo = 1; # figure and table caption numbering, for HTML do it manually
#Function to add the Table Number
capTab = function(x)
{
if(outputFormat == 'html'){
x = paste0("**Table ",capTabNo,".** ",x,"")
capTabNo <<- capTabNo + 1
}; x
}
#Function to add the Figure Number
capFig = function(x, show_R_version=FALSE, show_package_versions=NULL, is_map=FALSE)
{
if(outputFormat == 'html')
{
x <- paste0("**Figure ",capFigNo,".** ",x,"");
if( show_R_version || (!is.null(show_package_versions) && length(show_package_versions) > 0) )
{
x <- paste0(x, " Figure generated using ");
if( show_R_version ) x <- paste0(x, stringr::str_replace(R.version.string, stringr::fixed("R "), "[`R`](https://www.r-project.org/) "));
if( !is.null(show_package_versions) && length(show_package_versions) > 0 )
{
x <- paste0(x, ifelse( show_R_version, " and ", " "));
x <- paste0(x, ifelse( length(show_package_versions) > 1, "packages ", "package "));
x <- paste0(x, paste0(vapply(show_package_versions, function(x) paste0("`",x,"`", " (version ", packageVersion(x),")"), character(1)), collapse=", "), ".");
}
if( is_map ) x <- paste0(x, " Maps are using public domain data from the [Natural Earth project](https://www.naturalearthdata.com/) as provided by the `R` package `maps`.");
}
capFigNo <<- capFigNo + 1;
};
x;
}
########## reproducibility ##########
set.seed(2137)
# Chunk 2: read-raw
alle_raw <- read_csv(file.path(data_dir, "alle.csv"),
show_col_types = FALSE) |>
select(-1)        # drop the unnamed row-index column
praat_raw <- read_tsv(
file.path(data_dir, "out_praatSauce.tsv"),
na = c("", "NA", "--undefined--"),
show_col_types = FALSE,
col_types = cols(
file        = col_character(),
label       = col_character(),
intervaldID = col_integer(),
.default    = col_double()       # forces f0/F1/F2/CPP/H1H2/etc. to numeric
)
) |>
rename(intervalID = intervaldID) |>
filter(!is.na(intervalID))         # drops the single malformed row (line 434)
fric_raw <- read_tsv(file.path(data_dir, "spectralResultsFricatives.tsv"),
show_col_types = FALSE)
vdur_raw <- read_tsv(file.path(data_dir, "vowelDuration.txt"),
show_col_types = FALSE) |>
rename(file = FileName, vowel = digit, vowel_dur_ms = `Duration(ms)`)
# Chunk 3: column-dict
# Names of vector = original German column names; values = English replacements.
col_translations <- c(
Gruppe              = "group",
Bewertet            = "listener",
Spricht             = "speaker",
Belebtheit          = "animacy",
Art                 = "category",
Groesse             = "size",
Exemplar            = "item",
Kurz                = "item_code",
Runde_Durchgang     = "round_trial",
Geraten_Exemplar    = "picked_item",
Geraten_Kurz        = "picked_item_code",
Geraten_Belebtheit  = "picked_animacy",
Geraten_Art         = "picked_category",
Geraten_Groesse     = "picked_size",
Exemplar_Korrekt    = "item_correct",
Gruppe_Korrekt      = "group_correct",
Belebtheit_Korrekt  = "animacy_correct",
Art_Korrekt         = "category_correct",
Groesse_Korrekt     = "size_correct"
)
translate_columns <- function(old_names) {
new <- col_translations[old_names]
ifelse(is.na(new), old_names, new)
}
alle <- alle_raw |> rename_with(translate_columns)
# Chunk 4: value-translation
alle <- alle |>
mutate(
across(c(size, picked_size),
~ case_when(.x == "Gross" ~ "big",
.x == "Klein" ~ "small",
TRUE ~ .x)),
across(c(animacy, picked_animacy),
~ case_when(.x == "Belebt"   ~ "animate",
.x == "Unbelebt" ~ "inanimate",
TRUE ~ .x)),
across(c(category, picked_category),
~ case_when(.x == "Vogel"      ~ "bird",
.x == "Saeugetier" ~ "mammal",
.x == "Reptil"     ~ "reptile",
.x == "Geraet"     ~ "appliance",
.x == "Fahrzeug"   ~ "vehicle",
.x == "Instrument" ~ "instrument",
TRUE ~ .x))
)
